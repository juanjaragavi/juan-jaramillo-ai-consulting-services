---
import { getSinglePage } from "./contentParser.astro";

// get all taxonomies from frontmatter
export const getTaxonomy = async (
  collection: Parameters<typeof getSinglePage>[0],
  name: string,
) => {
  const singlePages = await getSinglePage(collection);
  const taxonomies = singlePages.reduce<string[]>((acc, page) => {
    const data = page.data as Record<string, unknown>;
    const field = data[name];
    if (Array.isArray(field)) {
      acc.push(
        ...field.filter((value): value is string => typeof value === "string"),
      );
    }
    return acc;
  }, []);

  return [...new Set(taxonomies)];
};
