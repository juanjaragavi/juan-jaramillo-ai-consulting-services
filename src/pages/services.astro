---
import { Image } from "astro:assets";
import PageHeader from "@/components/PageHeader.astro";
import Shape from "@/components/Shape.astro";
import Base from "@/layouts/Base.astro";
import Cta from "@/layouts/partials/Cta.astro";
import { getEntry, type CollectionEntry } from "astro:content";
import { AiFillCheckCircle } from "react-icons/ai";
import Accordion from "@/pages/components/accordion.mdx";

type HowItWorksEntry = CollectionEntry<"how-it-works">;

const how_it_works = await getEntry("how-it-works", "index");

if (!how_it_works) {
  throw new Error("How it works content is missing");
}

const data = how_it_works.data as HowItWorksEntry["data"] &
  Record<string, unknown>;

const perfomance = Array.isArray(data.perfomance)
  ? (data.perfomance as Array<{
      title?: string;
      description?: string;
      image?: string;
    }>)
  : [];
const ourWorks = Array.isArray(data.our_works)
  ? (data.our_works as Array<{
      title?: string;
      subtitle?: string;
      image?: string;
      list?: string[];
    }>)
  : [];

const page_data = {
  ...data,
  content: how_it_works.body,
};
---

<Base
  title={typeof data.title === "string" ? data.title : undefined}
  meta_title={typeof data.meta_title === "string" ? data.meta_title : undefined}
  description={typeof data.description === "string"
    ? data.description
    : undefined}
  image={typeof data.image === "string" ? data.image : undefined}
>
  <Shape />
  <section class="page-hero pb-14 pt-16">
    <div class="container">
      <div class="page-hero-content mx-auto max-w-[883px] text-center">
        <PageHeader page_data={page_data} />
      </div>

      <div class="row mt-14">
        {
          perfomance.map((item, i) => (
            <div class="mt-10 text-center sm:col-6 md:col-4 md:mb-0">
              <div
                class={`relative mx-auto mb-8 flex h-[184px] w-[184px] items-center justify-center rounded-xl bg-white p-4 shadow-lg ${
                  perfomance.length - 1 !== i
                    ? "after:absolute after:-right-4 after:-z-[1] after:hidden after:w-full after:translate-x-full after:border-b-2 after:border-dashed after:border-primary/50 after:content-[''] md:after:block"
                    : undefined
                }`}
              >
                {item.image ? (
                  <Image height={122} width={144} src={item.image} alt="" />
                ) : null}
              </div>
              <h2 class="h5">{item.title}</h2>
              {item.description ? <p class="mt-4">{item.description}</p> : null}
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      {
        ourWorks.map((item, index) => (
          <div class="row gx-5 mt-16 items-center first:mt-12">
            <div
              class={`lg:col-7 ${
                index % 2 === 0 ? "lg:order-1" : "lg:order-0"
              }`}
            >
              <div class="relative">
                {item.image ? (
                  <Image
                    class="w-full object-contain"
                    alt={item.title ?? "service"}
                    width={473}
                    height={286}
                    src={item.image}
                  />
                ) : null}
              </div>
            </div>
            <div
              class={`mt-6 lg:col-5 lg:mt-0 ${
                index % 2 === 0 ? "lg:order-0" : "lg:order-1"
              }`}
            >
              <div class="text-container">
                <h2 class="lg:text-2xl">{item.title}</h2>
                {item.subtitle ? (
                  <p class="lg:text-md mt-6">{item.subtitle}</p>
                ) : null}
                <ul class="mt-6 text-dark lg:-ml-4">
                  {(item.list ?? []).map((listItem) => (
                    <li class="mb-2 flex items-center rounded px-4">
                      <AiFillCheckCircle className="mr-3 fill-primary text-white" />
                      {listItem}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </section>
  <Accordion />
  <Cta />
</Base>
