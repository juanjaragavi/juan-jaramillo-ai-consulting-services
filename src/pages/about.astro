---
import { Image } from "astro:assets";
import PageHeader from "@/components/PageHeader.astro";
import Shape from "@/components/Shape.astro";
import Gallery from "@/components/about/Gallery.astro";
import Works from "@/components/about/Works.astro";
import Base from "@/layouts/Base.astro";
import Cta from "@/layouts/partials/Cta.astro";
import { getEntry, type CollectionEntry } from "astro:content";
import { AiFillCheckCircle } from "react-icons/ai";

type AboutEntry = CollectionEntry<"about">;

const about = await getEntry("about", "index");

if (!about) {
  throw new Error("About page content is missing");
}

const data = about.data as AboutEntry["data"] & Record<string, unknown>;

const ourWorks = Array.isArray(data.our_works)
  ? (data.our_works as Array<{
      title?: string;
      subtitle?: string;
      image?: string;
      list?: string[];
    }>)
  : [];
const gallery = (data.gallery ?? {}) as Record<string, unknown>;
const features = (data.features ?? {}) as Record<string, unknown>;

const page_data = {
  ...data,
  content: about.body,
};
---

<Base
  title={typeof data.title === "string" ? data.title : undefined}
  meta_title={typeof data.meta_title === "string" ? data.meta_title : undefined}
  description={typeof data.description === "string"
    ? data.description
    : undefined}
  image={typeof data.image === "string" ? data.image : undefined}
>
  <Shape />
  <section class="page-hero pt-16">
    <div class="container">
      <div class="page-hero-content mx-auto max-w-[768px] text-center">
        <PageHeader page_data={page_data} />
      </div>
      <!-- gellary -->
      <Gallery gallery={gallery} />
      <!-- our works -->
      <Works features={features} />

      <section class="mx-0 w-full min-w-full px-0">
        <div class="container mx-0 w-full min-w-full px-0">
          {
            ourWorks.map((item, index) => (
              <div class="row gx-5 mx-0 my-12 items-center px-0 first:mt-12">
                <div
                  class={`lg:col-6 xl:col-6 2xl:col-6 ${
                    index % 2 === 0 ? "lg:order-1" : "lg:order-0"
                  }`}
                >
                  <div class="relative">
                    <Image
                      class="w-full object-contain"
                      alt={item.title ?? "service"}
                      width={473}
                      height={286}
                      src={item.image ?? "/images/about/gallery-img-1.png"}
                    />
                  </div>
                </div>
                <div
                  class={`mx-0 mt-6 px-0 lg:col-6 xl:col-6 2xl:col-6 lg:mt-0 ${
                    index % 2 === 0 ? "lg:order-0" : "lg:order-1"
                  }`}
                >
                  <div class="text-container">
                    <h2 class="lg:text-2xl">{item.title}</h2>
                    {item.subtitle ? (
                      <p class="lg:text-md mt-6">{item.subtitle}</p>
                    ) : null}
                    <ul class="mt-6 text-dark lg:-ml-4 lg:text-sm lg:leading-4 xl:text-sm xl:leading-4 2xl:text-sm 2xl:leading-4">
                      {(item.list ?? []).map((listItem) => (
                        <li class="mb-2 flex items-center rounded px-4">
                          <AiFillCheckCircle className="mr-3 fill-primary text-white" />
                          {listItem}
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </section>
      <Cta />
    </div>
  </section>
</Base>
